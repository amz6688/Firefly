---
import type { SiteSection } from "@/config/sectionConfig";
import { sectionConfig } from "@/config/sectionConfig";
import { getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

interface Props {
	currentPostCategory?: string;
}

const { currentPostCategory } = Astro.props as Props;

const posts = await getSortedPostsList();

// 每个板块的文章数量 + 实际链接（最新板块指向首页）
const sections = sectionConfig.map((section: SiteSection) => {
	let count = 0;
	if (section.kind === "latest") {
		count = posts.length;
	} else if (section.kind === "category") {
		count = posts.filter((post) => post.data.category === section.value).length;
	} else if (section.kind === "tag") {
		count = posts.filter((post) =>
			(post.data.tags ?? []).includes(section.value as string),
		).length;
	}
	return {
		...section,
		count,
		href: url(section.slug ? `/sections/${section.slug}/` : "/"),
	};
});

// 分类名 → 板块 slug，用于文章页的弱高亮
const categoryToSection: Record<string, string> = {};
for (const section of sections) {
	if (section.kind === "category" && section.value) {
		categoryToSection[section.value] = section.slug;
	}
}

// 当前路径对应的板块：首页 → 最新（""）；板块页 → 对应 slug；其他页面 → 不高亮
const currentPath = Astro.url.pathname.replace(/\/$/, "");
let activeSlug = "__none__";
if (currentPath === "" || currentPath === "/") {
	activeSlug = "";
} else if (currentPath.startsWith("/sections/")) {
	activeSlug = currentPath.slice("/sections/".length);
}

const postCategory = (currentPostCategory || "").trim();
const softSlug = postCategory ? categoryToSection[postCategory] : undefined;
---

<div
  class="card-base category-bar p-3 onload-animation"
  id="category-bar"
  data-current-post-category={postCategory}
>
  <div class="category-scroll flex gap-2 overflow-x-auto">
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="category-pill focus-ring-inset text-sm px-4 py-1.5 whitespace-nowrap
                 transition-colors duration-150 ease-out flex items-center justify-center"
          data-section-slug={section.slug}
          data-category-name={section.kind === "latest" ? "" : section.value}
          data-active={section.slug === activeSlug ? "" : undefined}
          data-soft-active={
            softSlug && section.slug === softSlug ? "" : undefined
          }
        >
          {section.name}
          <span class="pill-count">{section.count}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .category-bar {
    margin-bottom: 1rem;
  }
  .category-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline define:vars={{ categoryToSection }}>
  function getActiveSectionSlug() {
    const path = window.location.pathname.replace(/\/$/, "");
    if (path === "" || path === "/") return "";
    if (path.startsWith("/sections/")) return path.slice("/sections/".length);
    return "__none__";
  }

  function syncCategoryBar() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const swupContainer = document.getElementById("swup-container");
    const postCategory = (
      swupContainer?.getAttribute("data-current-post-category") ||
      bar.getAttribute("data-current-post-category") ||
      ""
    ).trim();
    const softSlug = postCategory
      ? categoryToSection[postCategory] || ""
      : "";
    const activeSlug = getActiveSectionSlug();

    bar.querySelectorAll(".category-pill").forEach((pill) => {
      pill.removeAttribute("data-active");
      pill.removeAttribute("data-soft-active");
      const slug = pill.getAttribute("data-section-slug");
      if (slug === activeSlug) {
        pill.setAttribute("data-active", "");
      } else if (softSlug && slug === softSlug) {
        pill.setAttribute("data-soft-active", "");
      }
    });
  }

  syncCategoryBar();

  if (!window.__sectionBarInit) {
    window.__sectionBarInit = true;
    document.addEventListener("astro:page-load", syncCategoryBar);
    document.addEventListener("swup:contentReplaced", syncCategoryBar);
  }
</script>
